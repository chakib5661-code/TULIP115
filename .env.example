# Server Port (automatically injected by cloud hosting providers like Render, Railway, Fly, Heroku)
PORT=3000

# Environment mode ('production' or 'development')
NODE_ENV=production

# NOTE: GEMINI_API_KEY is NOT required by this application (no AI or Gemini APIs are used in this codebase).
# GEMINI_API_KEY=""

# Telegram Bot Integration (Optional for direct automated bot messaging)
TELEGRAM_BOT_TOKEN=AAFYIq74hxJeFeiQAPRx_g_WZ7R5fL0uwu8
TELEGRAM_CHAT_ID=-5365585827,5680755596

# Google Analytics 4 (Measurement ID)
# Format: G-XXXXXXXXXX (ex: G-7ABC123XYZ)
VITE_GA_MEASUREMENT_ID=
GA_MEASUREMENT_ID=

# Microsoft Clarity (Project ID)
# Format: 10-character alphanumeric project ID from https://clarity.microsoft.com (ex: k9x8w7v6u5)
VITE_CLARITY_PROJECT_ID=
CLARITY_PROJECT_ID=

# Supabase Storage Configuration (Vercel & Cloud deployment)
# Obtain these from your Supabase Project Settings -> API (https://supabase.com/dashboard/project/_/settings/api)
SUPABASE_URL=https://your-project-id.supabase.co
SUPABASE_SERVICE_ROLE_KEY=your-supabase-service-role-key-here
# Optional client anon key (can be used on frontend or backend)
SUPABASE_ANON_KEY=your-supabase-anon-key-here
VITE_SUPABASE_URL=https://your-project-id.supabase.co
VITE_SUPABASE_ANON_KEY=your-supabase-anon-key-here

